# =============================================================================
# Hosted-mode DRY RUN on your own machine.
#
# This is the production stack (browser execution, GitHub sign-in, Postgres
# progress) pointed at localhost instead of a domain, so you can rehearse the
# whole thing before deploying.
#
#   cp .env.hosted.local.example .env.hosted.local
#   docker compose -f docker-compose.hosted.yml --env-file .env.hosted.local up -d --build
#   open http://localhost
#
# The values below are already correct for local testing — the only thing you
# might add is a GitHub OAuth app (see TESTING.md, Part B step 5).
# NEVER use this file for a real deployment: TLS is off and the secrets are
# throwaway.
# =============================================================================

# ":80" tells Caddy to serve plain HTTP on port 80 for any hostname, and to
# skip certificate issuance — there is no public domain to validate here.
SITE_ADDRESS=:80

# What the app thinks its public URL is. Must match how you browse to it, and
# must match the callback URL of any test OAuth app.
BASE_URL=http://localhost

# Throwaway values — fine for a local rehearsal, never for production.
SECRET_KEY=local-dry-run-not-a-real-secret-key-000000
POSTGRES_PASSWORD=localtestpassword

# Leave empty to test the anonymous path (everything works, progress lives in
# the browser). Fill in to also test sign-in — see TESTING.md Part B step 5.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MUST be false here: browsers refuse "secure" cookies over plain http, so
# leaving this true makes sign-in fail silently. It is true in production.
COOKIE_SECURE=false

ALLOW_ANONYMOUS=true
TRUST_PROXY=false

PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v0.28.3/full/

RATE_LIMIT_WRITES_PER_MINUTE=120
