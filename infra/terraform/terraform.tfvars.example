# =============================================================================
# DataForged on AWS — edit this file, then run:
#
#   cd infra/terraform
#   cp terraform.tfvars.example terraform.tfvars   # if you haven't
#   # set domain_name, repo_url, budget_alert_email below
#   terraform init
#   terraform apply
#
# Or from the repo root (Linux/macOS/Git Bash):
#   ./scripts/deploy_aws.sh
#
# terraform.tfvars is git-ignored (holds OAuth secrets later).
# =============================================================================


# --- 1. Your domain (REQUIRED) ----------------------------------------------
# Buy the domain IN Route 53 (or create a public hosted zone and point NS).
# Bare domain only — no https://, no trailing slash, no example.com.
domain_name = "YOUR-DOMAIN.com"

# Which host to serve from:
#   ""       -> YOUR-DOMAIN.com  (+ www.YOUR-DOMAIN.com)
#   "learn"  -> learn.YOUR-DOMAIN.com
subdomain = ""


# --- 2. Where and how big ----------------------------------------------------
aws_region = "us-east-1"

# t4g.small  = 2 vCPU / 2 GiB, Graviton (arm64), ~$12–16/month — recommended.
instance_type         = "t4g.small"
instance_architecture = "arm64"

root_volume_gb = 20
data_volume_gb = 20   # encrypted EBS for Postgres Docker volumes


# --- 3. Your code (REQUIRED for one-click) ---------------------------------
# Must be a public https://…/*.git URL. This repo's default:
repo_url    = "https://github.com/TapiwaChikwenya/data-forged.git"
repo_branch = "main"


# --- 4. GitHub sign-in (SECOND apply only) ----------------------------------
# Leave empty on the first apply — the site works anonymously until you add OAuth.
# After the site is up, create the OAuth app, paste values, terraform apply again,
# then run: terraform output -raw apply_config_command
github_client_id     = ""
github_client_secret = ""

allow_anonymous = true


# --- 5. Access ---------------------------------------------------------------
# null = no SSH; use Session Manager (terraform output -raw shell_command).
ssh_ingress_cidr = null


# --- 6. Cost guard rail ------------------------------------------------------
# Real email required when monthly_budget_usd > 0. Or set monthly_budget_usd = 0.
monthly_budget_usd = 30
budget_alert_email = "YOUR-EMAIL@gmail.com"


# --- 7. Optional offsite backups --------------------------------------------
# Create an S3 bucket first, then set its name here (IAM + cron are wired).
# backup_s3_bucket = "my-dataforged-backups"


# --- 8. Advanced -------------------------------------------------------------
# pyodide_index_url = "https://cdn.jsdelivr.net/pyodide/v0.28.3/full/"
# environment = "prod"
