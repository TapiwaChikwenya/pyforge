# PyForge hosted deployment — copy to .env.hosted and fill in.
#   cp .env.hosted.example .env.hosted
# Never commit the filled-in file.

# The domain Caddy serves and requests a certificate for.
# Use ":80" (no TLS) only when testing locally without a domain.
SITE_ADDRESS=pyforge.example.com

# Public URL of the app. Must match SITE_ADDRESS and is used to build the
# OAuth callback: ${BASE_URL}/auth/callback
BASE_URL=https://pyforge.example.com

# Signs session cookies. Generate with:  openssl rand -hex 32
# Changing it signs everybody out. Losing it is harmless (users re-login).
SECRET_KEY=replace-me-with-32-random-bytes

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=replace-me-too

# GitHub OAuth app credentials (see DEPLOY.md §2).
# Leave blank to run without sign-in: visitors still get everything, with
# progress stored in their own browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Send cookies only over HTTPS. Set to false ONLY for local http testing.
COOKIE_SECURE=true

# Anonymous visitors can browse and run every exercise (recommended for a
# public resource). Set to false to require sign-in first.
# false = require GitHub sign-in for the UI and API (auth must be configured)
ALLOW_ANONYMOUS=true
# Trust X-Forwarded-For from Caddy when rate-limiting
TRUST_PROXY=true

# Where browsers load the Python runtime from. Must be a FULL Pyodide
# distribution (runtime + package wheels). To self-host, see DEPLOY.md §6.
PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v0.28.3/full/

# Per-IP write limit (progress saves). Generous by default.
RATE_LIMIT_WRITES_PER_MINUTE=120
