# PyForge — public hosted build.
#
# Deliberately minimal: this image serves the curriculum and stores progress.
# It has no Java, no Spark, no data-science libraries and no code-execution
# path, because learner code runs in the browser (Pyodide), never here.
FROM python:3.11-slim

RUN useradd --create-home --uid 10001 pyforge

WORKDIR /app

COPY requirements-hosted.txt .
RUN pip install --no-cache-dir -r requirements-hosted.txt

# Only what the hosted app actually needs (no runner.py — never imported
# in hosted mode, and leaving it out makes that guarantee physical).
COPY config.py store.py auth.py main.py ratelimit.py progress_keys.py ./
COPY curriculum*.py enrichment*.py interviews_core.py ./
COPY migrations ./migrations
COPY static ./static

RUN mkdir -p /app/data && chown -R pyforge:pyforge /app/data

USER pyforge

ENV PYFORGE_MODE=hosted \
    PYTHONUNBUFFERED=1 \
    TRUST_PROXY=true

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz').read()"

# Workers share the SQLite rate-limit DB and Postgres for progress/OAuth.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
